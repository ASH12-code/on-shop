# Proteksi Anti-RCE / Anti-Webshell pada Direktori Gambar Publik
<FilesMatch "\.(php|php5|php7|php8|phtml|phar|pl|py|cgi|sh|exe|bat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
